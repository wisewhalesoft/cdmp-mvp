# CDMP e2e (Playwright) — copy to .env and adjust for your environment.
# Never commit real credentials; these dev-seed accounts (apps/api/src/database/seeds/seed.ts)
# are non-sensitive local/CI-only fixtures, not production credentials.

# Frontend dev server (vite) the tests navigate to. Its own /api proxy forwards to the API.
E2E_BASE_URL=http://localhost:5173

# Login page route (adjust if the app's actual login route differs from /login).
E2E_LOGIN_PATH=/login

# admin@cdmp.test — role=admin (equivalent to business_role=director for E07 write access,
# see F079 BR-7). Covers all "director-capable" fidelity scenarios.
E2E_ADMIN_EMAIL=admin@cdmp.test
E2E_ADMIN_PASSWORD=P@ssw0rd123

# user@cdmp.test — role=user, business_role=null (no E07 access). Used for role-blocked assertions.
E2E_USER_EMAIL=user@cdmp.test
E2E_USER_PASSWORD=P@ssw0rd123

# Known gap (see docs/test-specs/risks-and-gaps.md, section "F117", R-F117-01):
# no dev-seed account exists with business_role='director' or 'section_chief'. If/when one is
# provisioned, add E2E_DIRECTOR_EMAIL/PASSWORD and E2E_SECTION_CHIEF_EMAIL/PASSWORD here and
# extend global-setup.ts's PERSONAS list + playwright.config.ts's projects accordingly.
