%% F075 — POOLDATA 篩選欄位白名單管理流程
%% 涵蓋: 初始 seed / 列表查看 / 新增 (含 categorical 提示跳轉 F076) / 編輯 / 停用 / 啟用
%% 配合 data-model.md#field-whitelist-entity 與 error-handling.md#assignment-code-errors

flowchart TD
    subgraph Init [系統初始化 - Admin 一次性執行]
        InitStart([Admin 執行 seed script]) --> InitSeed[Upsert 8 筆 field_whitelist<br/>PROD_KIND / LIST_TYPE / BEST_CASE / SPEC_TP /<br/>CASEYEAR / SETTLE_SRC / MONTH_CNT / PAYT_TERM]
        InitSeed --> InitCheck{冪等檢查<br/>column_name 已存在?}
        InitCheck -->|是| InitSkip[Skip — 不重複插入]
        InitCheck -->|否| InitInsert[INSERT 新紀錄]
    end

    subgraph Query [日常查看 - 部長 / Admin / 處長 皆可]
        QStart([進入 M06 POOLDATA 篩選欄位分頁]) --> QApi["GET /api/v1/assignment/pooldata-fields<br/>?includeInactive=true"]
        QApi --> QGuard{SalesManagerGuard<br/>通過?}
        QGuard -->|否| Q403[/403 AUTH_FORBIDDEN/]
        QGuard -->|是| QList[渲染表格<br/>含啟用 + 停用欄位]
        QList --> QRoleUI{角色判斷}
        QRoleUI -->|"處長"| QReadOnly[隱藏所有寫入按鈕<br/>F074 BR-7]
        QRoleUI -->|"部長 + Admin"| QFullUI[顯示新增 / 編輯 / 停用 / 啟用 / 管理可選值按鈕]
    end

    subgraph Write [寫入操作 - 僅部長 + Admin]
        WStart([部長點擊 新增 / 編輯 / 停用 / 啟用]) --> WApi[呼叫對應 POST / PUT 端點]
        WApi --> WGuard{DirectorGuard<br/>通過?}
        WGuard -->|否| W403[/403 E07_FORBIDDEN_DIRECTOR_ONLY/]
        WGuard -->|是| WAction{操作類型}

        WAction -->|"新增"| WCreate{column_name<br/>已存在?}
        WCreate -->|是| W422Dup[/422 WHITELIST_FIELD_DUPLICATE/]
        WCreate -->|否| WInsert[INSERT field_whitelist<br/>+ 寫 audit_log CREATE]
        WInsert --> WCatHint{field_type =<br/>categorical?}
        WCatHint -->|是| WReturnHint[回傳 hint=PLEASE_MAINTAIN_OPTIONS<br/>前端 toast 跳轉 F076]
        WCatHint -->|否| WReturn201[/201 Created/]
        WReturnHint --> WReturn201

        WAction -->|"編輯 displayName / fieldType"| WUpdate{fieldType 由 categorical<br/>改為其他?}
        WUpdate -->|是| WConfirm[前端 Modal 警告:<br/>F076 既有可選值不再套用<br/>確定繼續?]
        WUpdate -->|否| WUpdateExec[UPDATE field_whitelist<br/>+ 寫 audit_log UPDATE]
        WConfirm --> WUpdateExec

        WAction -->|"停用"| WDisable[UPDATE is_active=false<br/>+ 寫 audit_log DISABLE]
        WDisable --> WNote[註: 不回溯既有名單條件<br/>BR-3 / F061 月跑 Stage 1 仍正常讀取]

        WAction -->|"啟用"| WEnable[UPDATE is_active=true<br/>+ 寫 audit_log ENABLE]
    end

    QFullUI -.點擊管理可選值.-> F076Link([跳轉 F076 可選值管理頁])

    classDef passNode fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef errNode fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    classDef decisionNode fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef actionNode fill:#dbeafe,stroke:#2563eb,color:#1e3a8a

    class Q403,W403,W422Dup errNode
    class QGuard,WGuard,WAction,WCreate,WUpdate,WCatHint,QRoleUI,InitCheck decisionNode
    class WInsert,WUpdateExec,WDisable,WEnable,InitInsert actionNode
    class WReturn201,QFullUI,QReadOnly passNode
