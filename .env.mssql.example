# ── CDMP MSSQL 正式部署 .env 範本（AD-E07-44 P6）──
# 部署模型 = 外部 SQL Server（非 docker 容器）。用法：export 下列變數（或寫入部署載體的 env）後，
#   於 apps/api 執行 `npm run bootstrap`，並以相同連線啟動 api / worker。
# 注意：.env / .env.* 已在 .gitignore（勿 commit 密碼）；AES 金鑰產一次、存好、別更換（換掉 = 已補的 datasource 密碼作廢）。
# 金鑰產生：openssl rand -hex 32

# 正式環境：關閉 synchronize，schema 由 baseline migration 提供（migrations/mssql/*）。
NODE_ENV=production

# ── 金鑰（api / worker / bootstrap 共用同一把 AES）──
# datasource 密碼加解密用；不一致 → 測試連線解密失敗。
AES_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32
# 登入 JWT 簽章。
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ── 外部 MSSQL 連線 ──
DB_TYPE=mssql
DB_HOST=REPLACE_WITH_外部_MSSQL_HOST     # 如 172.20.202.212
DB_PORT=1433
DB_USERNAME=cdmp                          # 維運提供的真實 SQL app login
DB_PASSWORD=REPLACE_WITH_app_password
# 目標資料庫（DBA 建庫、collation=Chinese_Taiwan_Stroke_BIN，對齊來源系統硬性要求）。
DB_NAME=CDMP
# 傳輸加密 / 憑證信任（依實機 SSL 設定調整；自簽憑證 → trust=true）。
DB_MSSQL_ENCRYPT=true
DB_MSSQL_TRUST_CERT=true

# ── mssql 自建佇列輪詢間隔（worker；DB_TYPE=mssql 生效，取代 pg-boss）──
RUN_QUEUE_POLL_INTERVAL_MS=2000

# ── 內網網址（web 收到的 Host 由 edge 代理轉發；Vite 需允許，多個逗號分隔）──
VITE_ALLOWED_HOSTS=testcdmp.hfcfinance.com.tw

# ── 備註（useUTC / collation）──
# api / worker / bootstrap 之 mssql 連線一律 useUTC:true（見 data-source.ts / seed-connection.ts），
#   確保 date/datetime2 讀寫時區一致（I-MSSQL-DATE-TZ-01）；此為程式內建，無需於本檔設定。
# 資料庫 collation 必為 Chinese_Taiwan_Stroke_BIN（BIN 大小寫敏感），由 DBA 於建庫時指定。
