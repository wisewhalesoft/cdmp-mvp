# ── CDMP MSSQL 部署用 .env 範本（AD-E07-44 P6a）──
# 用法：cp .env.mssql.example .env  後填入金鑰。金鑰產生：openssl rand -hex 32
# 注意：.env 已在 .gitignore，勿 commit；AES 金鑰產一次、存好、別更換（換掉 = 已補的 datasource 密碼作廢）。
#
# 本檔對應 docker-compose.yml 的 mssql-prod / mssql-bootstrap profile（api-mssql/worker-mssql/web-mssql/bootstrap-mssql）。
# postgres 預設路徑不受影響（P6a 為 additive，不翻預設；預設切換由 P6b 處理）。

# 正式環境：關閉 synchronize，schema 由 baseline migration 提供（migrations/mssql/*）。
NODE_ENV=production

# ── 金鑰（api-mssql/worker-mssql/bootstrap-mssql 共用同一把 AES）──
# datasource 密碼加解密用；三服務不一致 → 測試連線解密失敗。
AES_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32
# 登入 JWT 簽章。
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ── MSSQL 連線（指向 compose 內 mssql 服務）──
# 帳號/密碼對齊 docker/mssql-init.sql 建立的 app login（cdmp / Cdmp_Dev_2026!）；
# 正式環境請改為維運提供的真實 SQL login 憑證。
DB_MSSQL_USERNAME=cdmp
DB_MSSQL_PASSWORD=Cdmp_Dev_2026!
# 目標資料庫（由 mssql-init.sql 建立、collation=Chinese_Taiwan_Stroke_BIN，對齊來源系統硬性要求）。
DB_MSSQL_NAME=CDMP
# 傳輸加密 / 憑證信任（本機 dev 容器自簽 → trust=true；正式環境依實機 SSL 設定調整）。
DB_MSSQL_ENCRYPT=true
DB_MSSQL_TRUST_CERT=true

# ── SA 密碼（僅 mssql / mssql-init 容器用；正式環境請改強密碼並妥善保管）──
MSSQL_SA_PASSWORD=Cdmp_Sa_2026!

# ── mssql 自建佇列輪詢間隔（worker-mssql；DB_TYPE=mssql 生效，取代 pg-boss）──
RUN_QUEUE_POLL_INTERVAL_MS=2000

# ── 選填：與 dev postgres 堆疊並存測試時，改 host port 避免衝突 ──
# MSSQL_API_PORT=3100
# MSSQL_WEB_PORT=5175

# ── 內網網址（web 收到的 Host 由 edge 代理轉發；Vite 需允許，多個逗號分隔）──
VITE_ALLOWED_HOSTS=testcdmp.hfcfinance.com.tw

# ── 備註（useUTC / collation）──
# api/worker/bootstrap 之 mssql 連線一律 useUTC:true（見 data-source.ts / seed-connection.ts），
#   確保 date/datetime2 讀寫時區一致（I-MSSQL-DATE-TZ-01）；此為程式內建，無需於本檔設定。
# 資料庫 collation 必為 Chinese_Taiwan_Stroke_BIN（BIN 大小寫敏感），由 mssql-init.sql 於建庫時指定。
