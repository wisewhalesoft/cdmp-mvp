# Database
# DB_TYPE: sqlite（單元測試 in-memory）| postgres（現行）| mssql（遷移目標）
# 注意：程式實際讀的是 DB_* 前綴（見 database/data-source.ts / app.module.ts），非 DATABASE_*。
DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1433
DB_NAME=cdmp
DB_USERNAME=cdmp
DB_PASSWORD=change_me

# MSSQL 專屬連線選項（tedious）
# 企業 MSSQL 常見：需 TLS 但憑證為自簽 → encrypt=true + trust=true
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true
# named instance 時填（例：SQLEXPRESS）；用 port 連線則留空
# DB_INSTANCE=

# 或改用單一連線字串（設了則優先於上面的拆開變數；供 smoke 腳本 / 手動測試）
# DB_CONNECTION_STRING=Server=host,1433;Database=cdmp;User Id=xx;Password=yy;Encrypt=true;TrustServerCertificate=true

# 本機 dev 容器（docker compose --profile mssql up -d mssql mssql-init 起的 cdmp-mssql）對應值：
#   DB_HOST=localhost / DB_PORT=1433 / DB_NAME=CDMP / DB_USERNAME=cdmp / DB_PASSWORD=Cdmp_Dev_2026!
#   DB_ENCRYPT=true / DB_TRUST_SERVER_CERT=true
# SA 密碼可用 MSSQL_SA_PASSWORD 覆寫；app login 密碼寫在 docker/mssql-init.sql（dev-only）

# 參考：現行 PostgreSQL 值（遷移完成後移除）
# DB_TYPE=postgres
# DB_PORT=5432

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=8h
JWT_REMEMBER_ME_EXPIRES_IN=30d

# AES Encryption
AES_ENCRYPTION_KEY=base64-encoded-256-bit-key

# App
APP_PORT=3000
APP_BASE_URL=http://localhost:5173

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=5
