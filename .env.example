# Database（MSSQL only；PG 已於 MSSQL 全面遷移後移除）
# DB_TYPE: mssql（正式）| sqlite（單元測試 in-memory，由 test/setup.ts 自動設定）
# 注意：程式實際讀的是 DB_* 前綴（見 database/data-source.ts / app.module.ts），非 DATABASE_*。
DB_TYPE=mssql
DB_HOST=your-mssql-host
DB_PORT=1433
DB_NAME=CDMP
DB_USERNAME=cdmp
DB_PASSWORD=change_me

# MSSQL 專屬連線選項（tedious）；程式讀 DB_MSSQL_* 前綴（見 app.module.ts / data-source.ts）。
# 企業 MSSQL 常見：需 TLS 但憑證為自簽 → encrypt=true + trust=true
DB_MSSQL_ENCRYPT=true
DB_MSSQL_TRUST_CERT=true
# tedious requestTimeout（ms）；長 migration / 大批操作需調高（預設 1hr，見 data-source.ts）
# DB_MSSQL_REQUEST_TIMEOUT=3600000

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=8h
JWT_REMEMBER_ME_EXPIRES_IN=30d

# AES Encryption
AES_ENCRYPTION_KEY=base64-encoded-256-bit-key

# App
APP_PORT=3000
APP_BASE_URL=http://localhost:5173

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=5
