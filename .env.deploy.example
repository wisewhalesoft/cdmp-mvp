# ── CDMP 部署用 .env 範本（docker compose 於同目錄自動讀取）──
# 用法：cp .env.deploy.example .env  後填入金鑰。金鑰產生：openssl rand -hex 32
# 注意：.env 已在 .gitignore，勿 commit；金鑰產一次、存好、別更換（換掉 = 已補的 datasource 密碼作廢）

# 正式/測試環境：關閉 synchronize，schema 由 migration baseline 提供
NODE_ENV=production

# ── 資料庫（Microsoft SQL Server 2022；外部，本 compose 不含 DB 容器）──
# 部署前先確認本主機可連到該 MSSQL（企業內網 IP，須網路可達）。
DB_TYPE=mssql
DB_HOST=your-mssql-host        # 例：172.20.202.212（dev/test 共用 CDMP）
DB_PORT=1433
DB_USERNAME=CDMPT
DB_PASSWORD=change_me
DB_NAME=CDMP
DB_MSSQL_ENCRYPT=true          # 企業自簽憑證常見：encrypt=true + trust=true
DB_MSSQL_TRUST_CERT=true

# 三個服務（api/worker/bootstrap）共用同一把，datasource 密碼加解密用
# ⚠️ 若連到「已存在、datasource 密碼已由他處加密」的 DB（如共用 dev/test CDMP），
#    請沿用「當初加密那把 key」——不要現產新的，否則既有 datasource 密碼全部解不開。
#    （本 repo 的 docker-compose.yml 內建一把預設 key；沿用 dev 環境者可直接不設此行、吃該預設。）
AES_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32
# 登入 JWT 簽章
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ── 內網網址 ──
# web 收到的 Host 由前門 edge 代理轉發；Vite 6 需允許該 host（多個逗號分隔）
VITE_ALLOWED_HOSTS=testcdmp.hfcfinance.com.tw

# 前門 edge 代理（80/443 + SSL）為「獨立 compose」，不吃本檔：
#   憑證放 certs/2026/、conf.d 見 edge/conf.d/，啟動：
#     docker compose up -d --build                     # 先起 CDMP
#     docker compose -f edge/docker-compose.yml up -d   # 再起 edge
#   詳見 README「內網網址 / SSL / 多站前門」。
