# ── CDMP 部署用 .env 範本（docker compose 於同目錄自動讀取）──
# 用法：cp .env.deploy.example .env  後填入金鑰。金鑰產生：openssl rand -hex 32
# 注意：.env 已在 .gitignore，勿 commit；金鑰產一次、存好、別更換（換掉 = 已補的 datasource 密碼作廢）

# 正式/測試環境：關閉 synchronize，schema 由 migration baseline 提供
NODE_ENV=production

# 三個服務（api/worker/bootstrap）共用同一把，datasource 密碼加解密用
AES_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32
# 登入 JWT 簽章
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ── 內網網址（方案 B：nginx 反向代理，推薦：單一入口 80，可加 HTTPS）──
COMPOSE_PROFILES=proxy
VITE_ALLOWED_HOSTS=testcdmp.hfcfinance.com.tw
# HTTP_PORT=80        # nginx 對外 port，預設即 80，通常不用設

# ── 方案 A（與方案 B 二擇一）：不用 nginx，直接把 web 開在 80 ──
# 若用方案 A：把上面 COMPOSE_PROFILES 那行拿掉，改用下面兩行
# WEB_PORT=80
# VITE_ALLOWED_HOSTS=testcdmp.hfcfinance.com.tw
